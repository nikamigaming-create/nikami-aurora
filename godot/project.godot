; Engine configuration file.
; Prefer editing through source control for deterministic runtime behavior.

config_version=5

[application]

config/name="Nikami Aurora"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Nikami.Aurora.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.006, 0.012, 0.025, 1)

[xr]

openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
openxr/startup_alert=false
openxr/extensions/render_model=true
openxr/extensions/meta/render_model=true
shaders/enabled=true
