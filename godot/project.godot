; Engine configuration file.
; Prefer editing through source control for deterministic runtime behavior.

config_version=5

[application]

config/name="Nikami Aurora"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Nikami.Aurora.Godot"

[editor]

movie_writer/video_quality=0.9
movie_writer/ogv/audio_quality=0.8

