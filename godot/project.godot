[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/atlas_16_bits=false
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=4
environment/ssao/half_size=false
environment/ssao/adaptive_target=1.0
environment/ssil/quality=4
environment/ssil/half_size=false
environment/ssil/adaptive_target=1.0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/screen_space_reflection/half_size=false
global_illumination/sdfgi/probe_ray_count=5
global_illumination/sdfgi/frames_to_update_lights=0
environment/volumetric_fog/use_filter=2
environment/defaults/default_clear_color=Color(0.006, 0.012, 0.025, 1)
lights_and_shadows/positional_shadow/atlas_size=8192

[xr]

openxr/startup_alert=false
openxr/extensions/render_model=true
shaders/enabled=true
openxr/extensions/meta/render_model=true
