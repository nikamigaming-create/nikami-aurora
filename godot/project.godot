[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.006, 0.012, 0.025, 1)

[xr]

openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
openxr/startup_alert=false
openxr/extensions/render_model=true
openxr/extensions/meta/render_model=true
openxr/extensions/spatial_entity/enabled=false
shaders/enabled=true
